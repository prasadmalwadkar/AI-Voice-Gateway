# =============================================================================
# HELOC VoIP Bridge — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# -- Cartesia Line SDK --
# Required for STT (speech-to-text) and TTS (text-to-speech) via Cartesia cloud.
# Get your key at: https://play.cartesia.ai/keys
CARTESIA_API_KEY=""

# -- Google Gemini (via LiteLLM) --
# The LLM that powers the mortgage assistant's reasoning.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# -- Twilio --

# -- Local Customer Prefill --
# Path to JSON file containing customer prefill payload keyed by caller phone number
TWILIO_PREFILL_BY_PHONE_FILE=""
# -- Server Configuration --
HOST=0.0.0.0
PORT=8000
PATH2_DEBUG_DETAILED=1

# -- Cartesia Agent Streaming (Advanced) --
# Override the default Cartesia WebSocket URL for agent streaming.
# Leave blank to use the default: wss://api.cartesia.ai/agents/stream/
# For local development with VoiceAgentApp, set to: ws://localhost:8000
# CARTESIA_AGENT_WS_URL=
# Sonic TTS playback speed (0.6–1.5); higher = faster speech
CARTESIA_TTS_SPEED=1.15
# Cartesia Ink only: seconds of silence before STT marks is_final (higher = fewer cuts mid-phrase; better for long addresses). Ignored when STT is Deepgram.
CARTESIA_STT_MAX_SILENCE_SECS=0.55
# Cartesia Ink only: minimum RMS/volume gate forwarded to Cartesia STT query (reduces noise finals). Ignored when STT is Deepgram.
CARTESIA_STT_MIN_VOLUME=0.08
# Seconds to wait after TTS consumer starts before first dequeue (Twilio playback warm-up).
TWILIO_TTS_STARTUP_DELAY_SECS=0.3
# Seconds to sleep after each Sonic utterance finishes so Twilio buffer drains before treating echo window / mic as “clear”.
TWILIO_TTS_DRAIN_SECS=0.25
# Seconds after last agent audio sent to Twilio: STT finals in this window treated as echo guard (barge/accept logic uses this).
TWILIO_PATH2_ECHO_GUARD_SECS=0.45
# When coalescing property-address STT fragments: idle time (seconds) after last fragment before flush to Line.
TWILIO_ADDRESS_FINAL_BUFFER_WINDOW_SECS=1.3
# Max buffered address fragments before flush even if window not elapsed.
TWILIO_ADDRESS_FINAL_BUFFER_MAX_FRAGMENTS=4
# Seconds to wait after last streamed token before sending accumulated Line text to TTS (fewer tiny Sonic calls). Note: value is seconds despite env name.
LINE_TTS_DEBOUNCE_SEC=0.25
# Seconds after a tool “Ask next” before Line client may inject a fallback ask if the model stayed silent (min 0.25 enforced in code).
LINE_TOOL_ASK_FALLBACK_SEC=0.8
# 1/true/yes/on: extra pipeline/STT/TTS debug logs for the Twilio bridge.
TWILIO_PIPELINE_DEBUG=1
# Max age (seconds) of last STT partial still usable to replace a weak final when inferring property address (avoids losing longer partial).
TWILIO_STT_PARTIAL_CACHE_MAX_AGE_SECS=1.8
# Log a media-stream frame counter summary every N inbound Twilio frames (receive-side debug cadence).
TWILIO_MEDIA_DEBUG_INTERVAL_FRAMES=100

# -- Twilio Path2 — μ-law VAD barge-in & playback tail --
# Energy-based interrupt while agent audio is considered “playing” (see TWILIO_PLAYBACK_TAIL_SECS).
# Lower RMS = easier interrupt (more noise false triggers); higher = harder interrupt.

# 1/true/yes/on: RMS-based barge-in during outbound playback (alongside STT partial/final barge-in).
TWILIO_VAD_BARGE_IN_ENABLED=1
# Minimum RMS per inbound μ-law frame (twilio_line_bridge._compute_mulaw_rms). Default 400.
TWILIO_VAD_RMS_THRESHOLD=400
# Consecutive frames above threshold before Twilio clear + TTS cancel. Default 3.
TWILIO_VAD_CONSEC_FRAMES=3
# Seconds after utterance start to ignore VAD (startup echo guard).
TWILIO_VAD_ECHO_GRACE_SECS=0.25

# Privacy/consent/legal TTS lowers effective RMS:
# max(TWILIO_VAD_CONSENT_MIN_RMS, int(TWILIO_VAD_RMS_THRESHOLD * TWILIO_VAD_CONSENT_RMS_FACTOR))
TWILIO_VAD_CONSENT_RMS_FACTOR=0.52
TWILIO_VAD_CONSENT_MIN_RMS=180

# Seconds after last outbound chunk: still treat playback as active (buffer tail / long prompts).
TWILIO_PLAYBACK_TAIL_SECS=3.0

# After barge-in: accept plausible finals this many seconds even inside echo guard.
TWILIO_BARGE_IN_FINAL_GRACE_SECS=2.5

# Suppress STT finals briefly after deterministic/agent prompts (avoid dropped answers).
TWILIO_PATH2_ANSWER_GUARD_SECS=2.0

# Silence after agent finishes before “didn’t hear you” watchdog (general vs consent wording).
TWILIO_CALLER_RESPONSE_WATCHDOG_SECS=10.0
TWILIO_CALLER_RESPONSE_WATCHDOG_CONSENT_SECS=18.0

# Consent-decline hangup: yield before end_call; drain waits use TERMINAL_* .
CONSENT_DECLINE_SIGNAL_DELAY_SEC=0.08
TERMINAL_PLAYBACK_MAX_WAIT_SEC=120
TERMINAL_IDLE_STABLE_MS=220

# Twilio bridge streaming STT backend: cartesia (Ink) or deepgram (Flux).
PATH2_STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=""


# Deepgram Flux model id for listen URL.
DEEPGRAM_STT_MODEL=flux-general-en
# Flux end-of-turn confidence threshold (higher = stricter EOT, fewer early finals).
DEEPGRAM_STT_EOT_THRESHOLD=0.7
# Flux “eager” EOT threshold (empty string omits param). Lower can finalize sooner; tune with EOT_THRESHOLD.
DEEPGRAM_STT_EAGER_EOT_THRESHOLD=0.4
# Milliseconds Flux waits on silence before forcing end-of-turn.
DEEPGRAM_STT_EOT_TIMEOUT_MS=3000
